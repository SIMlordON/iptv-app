<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="#B9861B" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#2F4A73" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="#8FB4FF" /></shape>
    </item>
    <item>
        <shape><solid android:color="#161C25" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
